<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollViewHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="100dp">

        <!-- Search Bar -->
        <LinearLayout
            android:id="@+id/llSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:elevation="2dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/accent_purple" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="Search AI bots, personalities..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Trending Section Header -->
        <TextView
            android:id="@+id/tvFeaturedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Trending Now"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llSearch" />

        <!-- Featured Skeleton -->
        <LinearLayout
            android:id="@+id/skeletonFeatured"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvFeaturedTitle">
            <include layout="@layout/item_skeleton_featured" />
            <include layout="@layout/item_skeleton_featured" />
        </LinearLayout>

        <!-- Featured Horizontal List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeatured"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/tvFeaturedTitle"
            tools:listitem="@layout/item_featured_bot" />

        <!-- Categories and Filter -->
        <LinearLayout
            android:id="@+id/llFilterContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/rvFeatured">

            <ImageView
                android:id="@+id/btnFilter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip_unselected"
                android:padding="12dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/accent_purple" />

            <HorizontalScrollView
                android:id="@+id/svChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/chipPopular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Popular"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Bold"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipNormal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Normal"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipProfessional"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Professional"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipFriendly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Friendly"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipRomantic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Romantic"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipFlirty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Flirty"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipAngry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Angry"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipIndian"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Indian"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipArab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Arab"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipEuropean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="European"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipJapanese"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Japanese"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipShy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Shy"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipMature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:text="Mature"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Discover Section Header -->
        <TextView
            android:id="@+id/tvDiscoverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Explore All"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llFilterContainer" />

        <!-- Discover Skeleton (RE-ADDED) -->
        <GridLayout
            android:id="@+id/skeletonDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:columnCount="2"
            app:layout_constraintTop_toBottomOf="@id/tvDiscoverTitle">
            <include layout="@layout/item_skeleton_grid" android:layout_width="0dp" android:layout_columnWeight="1" />
            <include layout="@layout/item_skeleton_grid" android:layout_width="0dp" android:layout_columnWeight="1" />
        </GridLayout>

        <!-- Vertical Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDiscover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/tvDiscoverTitle"
            app:spanCount="2"
            tools:listitem="@layout/item_bot_grid" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
