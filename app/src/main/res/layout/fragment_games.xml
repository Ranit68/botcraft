<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Tabs -->
    <LinearLayout
        android:id="@+id/llGameTabs"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_card"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tabGuess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="GUESS"
            android:textColor="@color/accent_purple"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabStory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="STORY"
            android:textColor="@color/text_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabSpin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SPIN"
            android:textColor="@color/text_label"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/tabIndicator"
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:background="@color/accent_purple"
        app:layout_constraintTop_toBottomOf="@id/llGameTabs"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerGames"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabIndicator" />

</androidx.constraintlayout.widget.ConstraintLayout>
