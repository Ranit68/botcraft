<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <View
        android:id="@+id/imgSkeleton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/nameSkeleton"
        android:layout_width="120dp"
        android:layout_height="18dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintStart_toEndOf="@id/imgSkeleton"
        app:layout_constraintTop_toTopOf="@id/imgSkeleton" />

    <View
        android:layout_width="200dp"
        android:layout_height="14dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_skeleton"
        app:layout_constraintStart_toStartOf="@id/nameSkeleton"
        app:layout_constraintTop_toBottomOf="@id/nameSkeleton" />

</androidx.constraintlayout.widget.ConstraintLayout>