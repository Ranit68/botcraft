<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chstbot"
        android:usesCleartextTraffic="true">

        <!-- AdMob App ID (Test ID) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
        
        <activity
            android:name="com.ranit.botscraft.ForgotPasswordActivity"
            android:exported="false" />
            
        <activity
            android:name="com.ranit.botscraft.ui.RegisterActivity"
            android:exported="false" />

        <activity
            android:name="com.ranit.botscraft.ui.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <activity
            android:name="com.ranit.botscraft.ui.BotProfileActivity"
            android:exported="false" />

        <activity
            android:name="com.ranit.botscraft.ui.LoginActivity"
            android:exported="false" />
            
        <activity
            android:name="com.ranit.botscraft.ui.BuyCreditsActivity"
            android:exported="false" />
            
        <activity
            android:name="com.ranit.botscraft.ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name="com.ranit.botscraft.ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
            
        <activity
            android:name="com.ranit.botscraft.ui.ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.ImageViewer" />
            
    </application>

</manifest>
